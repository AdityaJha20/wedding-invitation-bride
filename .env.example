# ==============================================================================
# Manya & Sarthak Wedding Invitation — Environment Configuration
# ==============================================================================

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<db_user>:<db_password>@<cluster-address>/wedding_invitation?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for Admin Authentication Cookie (min 32 random characters recommended)
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# Port for Express Backend Server
PORT=5000

# Client Frontend Origin for CORS (Vite development default is http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Optional: Admin Seed Configuration (Used by npm run create-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend API Base URL (leave empty in development to use Vite's built-in proxy)
VITE_API_BASE_URL=
